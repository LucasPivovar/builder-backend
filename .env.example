PORT=3000
# Em produção, use o domínio público exato, com https.
FRONTEND_ORIGINS=https://app.seudominio.com
# Pasta persistente, fora da área de releases, para banco e segredo JWT.
DATA_DIR=/www/wwwroot/astro-builder-data
# Pasta onde cada página publicada vira /p/{projeto}/index.html
PUBLISHED_SITES_DIR=/www/wwwroot/astro-builder-sites
# URL pública do backend/proxy que serve /p
PUBLIC_BASE_URL=https://pages.seudominio.com
# Alvo CNAME exibido para o cliente apontar domínio próprio
DNS_CNAME_TARGET=pages.seudominio.com
# strict: domínio customizado só ativa depois de DNS apontar corretamente. off: apenas dev/teste.
DOMAIN_VERIFICATION_MODE=strict
# Opcional para validar domínio raiz com registro A/AAAA.
PUBLIC_SERVER_IPS=203.0.113.10
MAX_PUBLICATION_HTML_BYTES=2000000
MAX_PUBLICATIONS_PER_USER=200
MAX_CUSTOM_DOMAINS_PER_USER=50
# Em produção use 0.0.0.0 no gerenciador de processo/proxy se precisar expor fora do host.
# Gere com: openssl rand -hex 48
JWT_SECRET=COLOQUE_UM_SEGREDO_COM_PELO_MENOS_32_CARACTERES
