PORT=3000
HOST=127.0.0.1
# Em produção, use o domínio público exato, com https.
FRONTEND_ORIGINS=https://app.seudominio.com
# Pasta persistente, fora da área de releases, para banco e segredo JWT.
DATA_DIR=/www/wwwroot/astro-builder-data
# Pasta onde cada página publicada vira /p/{projeto}/index.html
PUBLISHED_SITES_DIR=/www/wwwroot/astro-builder-sites
# Arquivos de VSL enviados pelos usuários. Mantenha fora da pasta de releases.
HOSTED_VIDEOS_DIR=/www/wwwroot/astro-builder-videos
MAX_HOSTED_VIDEO_BYTES=1000000000
MAX_HOSTED_VIDEOS_PER_USER=50
MAX_HOSTED_VIDEO_STORAGE_BYTES=10000000000
HOSTED_ASSETS_DIR=/www/wwwroot/astro-builder-assets
MAX_HOSTED_ASSET_BYTES=10000000
MAX_HOSTED_ASSET_STORAGE_BYTES=500000000
# URL pública do backend/proxy que serve /p
PUBLIC_BASE_URL=https://pages.seudominio.com
# Alvo CNAME exibido para o cliente apontar domínio próprio
DNS_CNAME_TARGET=pages.seudominio.com
# strict: domínio customizado só ativa depois de DNS apontar corretamente. off: apenas dev/teste.
DOMAIN_VERIFICATION_MODE=strict
# Opcional para validar domínio raiz com registro A/AAAA.
PUBLIC_SERVER_IPS=203.0.113.10
MAX_PUBLICATION_HTML_BYTES=2000000
MAX_PUBLICATIONS_PER_USER=200
MAX_CUSTOM_DOMAINS_PER_USER=50
# Em produção use 0.0.0.0 no gerenciador de processo/proxy se precisar expor fora do host.
# Gere com: openssl rand -hex 48
JWT_SECRET=COLOQUE_UM_SEGREDO_COM_PELO_MENOS_32_CARACTERES
# Apenas desenvolvimento local. Em produção deixe false e envie o token por um provedor de e-mail.
EXPOSE_PASSWORD_RESET_TOKEN=false
# URL opcional de checkout externo. Receberá plan, reference e email na query string.
BILLING_CHECKOUT_URL=
SUPPORT_ATTACHMENTS_DIR=./data/support-attachments
MAX_SUPPORT_ATTACHMENT_BYTES=5000000
MAIL_DELIVERY_WEBHOOK_URL=
MAIL_DELIVERY_TOKEN=
MAIL_WEBHOOK_SECRET=
REQUIRE_ANALYTICS_SIGNATURE=true
ANALYTICS_RETENTION_DAYS=365
LEAD_RETENTION_DAYS=730
DB_TYPE=sqljs
DATABASE_URL=
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SYNCHRONIZE=false
STRUCTURED_LOGS=true
BACKUP_DIR=./backups
BACKUP_RETENTION=14
ENABLE_API_DOCS=false
BOOTSTRAP_ADMIN_EMAIL=admin@seudominio.com
REQUIRE_EMAIL_VERIFICATION=true
EXPOSE_EMAIL_VERIFICATION_TOKEN=false
MAIL_FROM_NAME=Astro Builder
